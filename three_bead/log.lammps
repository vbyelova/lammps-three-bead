##########################################
# network percolation

#fix ntwrk0 all bond/create 100 1 1 0.8 2
#fix ntwrk1 all bond/create 100 2 2 0.8 2

##########################################

# bond react

fix rxn all bond/react stabilization no   react rxn1 stickers 1 2.0 3.0 mol1 mol2 map_three_bead   prob 0.05 ${seed}   react rxn2 stickers 1 2.0 3.0 mol2 mol1 map_three_bead   prob 0 ${seed}
fix rxn all bond/react stabilization no   react rxn1 stickers 1 2.0 3.0 mol1 mol2 map_three_bead   prob 0.05 349503   react rxn2 stickers 1 2.0 3.0 mol2 mol1 map_three_bead   prob 0 ${seed}
fix rxn all bond/react stabilization no   react rxn1 stickers 1 2.0 3.0 mol1 mol2 map_three_bead   prob 0.05 349503   react rxn2 stickers 1 2.0 3.0 mol2 mol1 map_three_bead   prob 0 349503
dynamic group bond_react_MASTER_group defined

compute nbonds all count/type bond
variable tempbonds equal c_nbonds[2]


#compute coords all property/atom xu yu zu
group firstatom id 1
1 atoms in group firstatom
group lastatom id 3
1 atoms in group lastatom

compute cfirst firstatom com
compute clast lastatom com
variable dx equal c_clast[1]-c_cfirst[1]
variable dy equal c_clast[2]-c_cfirst[2]
variable dz equal c_clast[3]-c_cfirst[3]

variable separation equal sqrt(v_dx*v_dx+v_dy*v_dy+v_dz*v_dz)

fix myTADAfile all print v_s "${t} ${tempbonds} ${separation} " file output/nbonds.dat screen no

##########################################
# simulate

# minimize 1.0e-4 1.0e-6 1000 10000

timestep ${tstep}
timestep 0.001
#reset_timestep 0
neigh_modify every 10 delay 20 check yes

run ${Nsteps}
run 100000

