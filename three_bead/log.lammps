LAMMPS (19 Nov 2024)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:99)
  using 1 OpenMP thread(s) per MPI task
# simulation of three bead model with network percolation and
# conformational change.


##########################################

# user input
variable Nsteps         equal 100000
variable Nwrite         equal   1000
variable seed           equal 349503
variable tstep          equal  0.001
variable stretch_force  equal     10

##########################################

# configuration
units lj
boundary p p p
atom_style bond         # bead-spring polymer
read_data network.in extra/bond/per/atom 2 extra/special/per/atom 3
Reading data file ...
  orthogonal box = (-10 -10 -10) to (10 10 10)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  15 atoms
  scanning bonds ...
  4 = max bonds/atom
  orthogonal box = (-10 -10 -10) to (10 10 10)
  1 by 1 by 1 MPI processor grid
  reading bonds ...
  15 bonds
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     2 = max # of 1-3 neighbors
     4 = max # of 1-4 neighbors
     5 = max # of special neighbors
  special bonds CPU = 0.000 seconds
  read_data CPU = 0.001 seconds

labelmap atom 1 stic 2 hinge

group stickers         type 1
10 atoms in group stickers
group hinges           type 2
5 atoms in group hinges


molecule mol1 bonded_three_bead.data
Read molecule template mol1:
bonded three bead
  1 molecules
  0 fragments
  3 atoms with max type 2
  3 bonds with max type 2
  0 angles with max type 0
  0 dihedrals with max type 0
  0 impropers with max type 0
molecule mol2 unbonded_three_bead.data
Read molecule template mol2:
unbonded three bead
  1 molecules
  0 fragments
  3 atoms with max type 2
  2 bonds with max type 1
  0 angles with max type 0
  0 dihedrals with max type 0
  0 impropers with max type 0

##########################################

# pair interactions
# shifted lj to be repulsive wca

pair_style lj/cut 2.5
#pair_modify shift yes

pair_coeff 1 1 1.5 1.0
pair_coeff 1 2 1.5 1.0
pair_coeff 2 2 1.5 1.0
pair_coeff * * 1.5 1.0

##########################################
# bond potentials

bond_style harmonic
bond_coeff 1 3 2        # sticker-hinge   (intra)
bond_coeff 2 3 2        # sticker-sticker (intra)
bond_coeff 3 3 2        # sticker-sticker (inter)
bond_coeff 4 3 2        # hinge-hinge     (inter)
bond_coeff 5 3 2        # sticker-hinge   (inter)


##########################################

# add brownian dynamics

fix 1 all nve                             # NVE integrator
fix 2 all langevin   0.5 0.5 2.0 ${seed}  # langevin thermostat
fix 2 all langevin   0.5 0.5 2.0 349503  

##########################################

# EXPORT

#### Set up a compute for msd
variable t equal step*${tstep}
variable t equal step*0.001
#### 1. MSD
compute mymsdcompute all msd
#### and write it to a file
variable themsd equal c_mymsdcompute[4]

variable        s equal logfreq(10,8,10)
#fix mymsdfile all print v_s "${t} ${themsd}" file output/msd.dat screen no

#### 2. THERMODYNAMICS INFO
thermo ${Nwrite}   # print thermodynamic info every Nwrite steps
thermo 1000   

dump 1 all atom ${Nwrite} output/dump.lammpstrj
dump 1 all atom 1000 output/dump.lammpstrj

##########################################

# minimize

minimize 1.0e-4 1.0e-6 10000 100000

