#unfix equil

##########################################

# pair interactions
# shifted lj to be repulsive wca

pair_style lj/cut 4.0
pair_modify shift yes

pair_coeff * * 2.5 0.5

##########################################

# variables for bell equation

compute bondhinge hinges bond/local engpot
compute bondstic stickers bond/local engpot
variable bhinge equal c_bondhinge
variable bstic equal c_bondstic
compute ke_atom all ke/atom
variable ke atom c_ke_atom

variable ebarrier equal 100 # energy barrier

#variable bell_k equal (-v_ebarrier-v_benergy*3.0)/0.5

#dump 2 all local ${Nwrite} output/tmphinge.dump index c_bondhinge
#dump 3 all local ${Nwrite} output/tmpstic.dump index c_bondstic

##########################################

##########################################

# bond react

# the only intramolecular reaction is the unfolding process
# the intermolecular reactions are all bond formations between each atom type
fix rxn all bond/react stabilization no reset_mol_ids no   react unfolding all 1 2.9 3.0 folded unfolded map_three_bead molecule intra   react ssfu all 1 2.0 2.4 pre_ssfu post_ssfu intermoltemps/sticstic_inter.map molecule inter   react ssff all 1 2.0 2.4 pre_ssff post_ssff intermoltemps/sticstic_inter.map molecule inter   react ssuu all 1 2.0 2.4 pre_ssuu post_ssuu intermoltemps/sticstic_inter.map molecule inter   react hhfu all 1 2.0 2.4 pre_hhfu post_hhfu intermoltemps/hingehinge_inter.map molecule inter   react hhff all 1 2.0 2.4 pre_hhff post_hhff intermoltemps/hingehinge_inter.map molecule inter   react hhuu all 1 2.0 2.4 pre_hhuu post_hhuu intermoltemps/hingehinge_inter.map molecule inter   react ishfu all 1 2.0 2.4 pre_ishfu post_ishfu intermoltemps/instic_hinge_inter.map molecule inter   react ishff all 1 2.0 2.4 pre_ishff post_ishff intermoltemps/instic_hinge_inter.map molecule inter   react ishuu all 1 2.0 2.4 pre_ishuu post_ishuu intermoltemps/instic_hinge_inter.map molecule inter   react oshfu all 1 2.0 2.4 pre_oshfu post_oshfu intermoltemps/outstic_hinge_inter.map molecule inter   react oshff all 1 2.0 2.4 pre_oshff post_oshff intermoltemps/outstic_hinge_inter.map molecule inter   react oshuu all 1 2.0 2.4 pre_oshuu post_oshuu intermoltemps/outstic_hinge_inter.map molecule inter
dynamic group bond_react_MASTER_group defined

compute nbonds all count/type bond
variable shintra equal c_nbonds[1]
variable ssintra equal c_nbonds[2]
variable ssinter equal c_nbonds[3]
variable shinter equal c_nbonds[4]
variable hhinter equal c_nbonds[5]

#compute coords all property/atom xu yu zu
group firstatom id 1
1 atoms in group firstatom
group lastatom id 3
1 atoms in group lastatom

compute cfirst firstatom com
compute clast lastatom com
variable dx equal c_clast[1]-c_cfirst[1]
variable dy equal c_clast[2]-c_cfirst[2]
variable dz equal c_clast[3]-c_cfirst[3]

variable separation equal sqrt(v_dx*v_dx+v_dy*v_dy+v_dz*v_dz)

fix nbondsfile all print v_s "${t} ${ssintra} ${ssinter} ${shinter} ${hhinter} " file output/nbonds.dat screen no

##########################################
# simulate

# minimize 1.0e-4 1.0e-6 1000 10000

timestep ${tstep}
timestep 0.001
#reset_timestep 0
#neigh_modify every 1 delay 2 check yes

run ${Nsteps}
run 100000

