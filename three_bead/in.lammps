# simulation of three bead model with network percolation and
# conformational change.


##########################################

# user input
variable Nsteps         equal 200000
variable Nwrite         equal   1000
variable seed           equal 349503
variable tstep          equal  0.001
variable stretch_force  equal     10

##########################################

# configuration
units lj
boundary p p p
atom_style bond         # bead-spring polymer
read_data network.in extra/bond/per/atom 2 extra/special/per/atom 3

labelmap atom 1 stic 2 hinge

group stickers         type 1
group hinges           type 2

# three bead unfolding template loading
molecule folded folded_three_bead.data
molecule unfolded unfolded_three_bead.data

# intermolecular template loading

# loading sticker-sticker intermolecular templates
molecule pre_ssfu intermoltemps/pre_sticstic_fu_inter.data
molecule post_ssfu intermoltemps/post_sticstic_fu_inter.data
molecule pre_ssff intermoltemps/post_sticstic_ff_inter.data
molecule post_ssff intermoltemps/post_sticstic_ff_inter.data
molecule pre_ssuu intermoltemps/pre_sticstic_uu_inter.data
molecule post_ssuu intermoltemps/post_sticstic_uu_inter.data

# loading hinge-hinge intermolecular templates
molecule pre_hhfu intermoltemps/pre_hingehinge_fu_inter.data
molecule post_hhfu intermoltemps/post_hingehinge_fu_inter.data
molecule pre_hhff intermoltemps/pre_hingehinge_ff_inter.data
molecule post_hhff intermoltemps/post_hingehinge_ff_inter.data
molecule pre_hhuu intermoltemps/pre_hingehinge_uu_inter.data
molecule post_hhuu intermoltemps/post_hingehinge_uu_inter.data

# loading sticker-hinge intermolecular templates. one is for outer sticker, one is for inner sticker
molecule pre_ishfu intermoltemps/pre_instic_hinge_fu_inter.data
molecule post_ishfu intermoltemps/post_instic_hinge_fu_inter.data
molecule pre_ishff intermoltemps/pre_instic_hinge_ff_inter.data
molecule post_ishff intermoltemps/post_instic_hinge_ff_inter.data
molecule pre_ishuu intermoltemps/pre_instic_hinge_uu_inter.data
molecule post_ishuu intermoltemps/pre_instic_hinge_uu_inter.data

molecule pre_oshfu intermoltemps/pre_outstic_hinge_fu_inter.data
molecule post_oshfu intermoltemps/post_outstic_hinge_fu_inter.data
molecule pre_oshff intermoltemps/pre_outstic_hinge_ff_inter.data
molecule post_oshff intermoltemps/post_outstic_hinge_ff_inter.data
molecule pre_oshuu intermoltemps/pre_outstic_hinge_uu_inter.data
molecule post_oshuu intermoltemps/pre_outstic_hinge_uu_inter.data

##########################################
# bond potentials

bond_style harmonic
bond_coeff 1 3 2        # sticker-hinge   (intra)
bond_coeff 2 3 2        # sticker-sticker (intra)
bond_coeff 3 3 2        # sticker-sticker (inter)
bond_coeff 4 3 2        # sticker-hinge   (inter)
bond_coeff 5 3 2        # hinge-hinge     (inter)


##########################################

# add brownian dynamics

fix 1 all nve                             # NVE integrator
fix 2 all langevin   1 1 2.0 ${seed}  # langevin thermostat

##########################################

# thermodynamic info

variable t equal step*${tstep}

#thermo_style custom step temp 
thermo ${Nwrite}   # print thermodynamic info every Nwrite steps

#dump 1 all atom ${Nwrite} output/dump.lammpstrj
#dump_modify 1 sort id
dump 2 all custom ${Nwrite} output/dump.lammpstrj id type mol x y z
dump_modify 2 sort id

##########################################

# equilibration

pair_style soft 2.5
pair_coeff * * 10

velocity all create 1 203933 rot yes dist gaussian
#neigh_modify every 1 delay 2 check yes
run 20000

##########################################

# pair interactions
# shifted lj to be repulsive wca

pair_style lj/cut 4.0
pair_modify shift yes

pair_coeff * * 2.5 1.5

##########################################

# variables for bell equation

compute bondhinge hinges bond/local engpot
compute bondstic stickers bond/local engpot
variable bhinge equal c_bondhinge
variable bstic equal c_bondstic
compute ke_atom all ke/atom
variable ke atom c_ke_atom

variable ebarrier equal 100 # energy barrier

##########################################

# bond react

# the only intramolecular reaction is the unfolding process
# the intermolecular reactions are all bond formations between each atom type
fix rxn all bond/react stabilization no reset_mol_ids no &
  react unfolding all 1 3.0 4.5 folded unfolded map_three_bead molecule intra &
  react ssfu all 1 2.0 2.4 pre_ssfu post_ssfu intermoltemps/sticstic_inter.map molecule inter &
  react ssff all 1 2.0 2.4 pre_ssff post_ssff intermoltemps/sticstic_inter.map molecule inter &
  react ssuu all 1 2.0 2.4 pre_ssuu post_ssuu intermoltemps/sticstic_inter.map molecule inter &
  react hhfu all 1 2.0 2.4 pre_hhfu post_hhfu intermoltemps/hingehinge_inter.map molecule inter &
  react hhff all 1 2.0 2.4 pre_hhff post_hhff intermoltemps/hingehinge_inter.map molecule inter &
  react hhuu all 1 2.0 2.4 pre_hhuu post_hhuu intermoltemps/hingehinge_inter.map molecule inter &
  react ishfu all 1 2.0 2.4 pre_ishfu post_ishfu intermoltemps/instic_hinge_inter.map molecule inter &
  react ishff all 1 2.0 2.4 pre_ishff post_ishff intermoltemps/instic_hinge_inter.map molecule inter &
  react ishuu all 1 2.0 2.4 pre_ishuu post_ishuu intermoltemps/instic_hinge_inter.map molecule inter &
  react oshfu all 1 2.0 2.4 pre_oshfu post_oshfu intermoltemps/outstic_hinge_inter.map molecule inter &
  react oshff all 1 2.0 2.4 pre_oshff post_oshff intermoltemps/outstic_hinge_inter.map molecule inter &
  react oshuu all 1 2.0 2.4 pre_oshuu post_oshuu intermoltemps/outstic_hinge_inter.map molecule inter 

# keep track of bonds across the system

compute nbonds all count/type bond
variable shintra equal c_nbonds[1]
variable ssintra equal c_nbonds[2]
variable ssinter equal c_nbonds[3]
variable shinter equal c_nbonds[4]
variable hhinter equal c_nbonds[5]

# find separation of atoms for av. bond length

group firstatom id 1
group lastatom id 3

compute cfirst firstatom com
compute clast lastatom com
variable dx equal c_clast[1]-c_cfirst[1]
variable dy equal c_clast[2]-c_cfirst[2]
variable dz equal c_clast[3]-c_cfirst[3]

variable separation equal sqrt(v_dx*v_dx+v_dy*v_dy+v_dz*v_dz)

fix nbondsfile all print 1000 "${t} ${ssintra} ${ssinter} ${shinter} ${hhinter} " file output/nbonds.dat screen no

##########################################

# count bonds per atom

compute shintra all nbond/atom bond/type 1
compute ssintra all nbond/atom bond/type 2
compute ssinter all nbond/atom bond/type 3
compute shinter all nbond/atom bond/type 4
compute hhinter all nbond/atom bond/type 5

dump ssintrafile all custom 1000 output/ssintra.dump id type mol c_ssintra
dump_modify ssintrafile sort id
#fix ssintrafile all print 1000 "${t} ${ssperatom}" file output/ssintra.dat screen no

##########################################

# rdf 

#compute myRDF all rdf 50
#fix rdf all ave/time 100 1 100 c_myRDF[*] file output/tmp.rdf mode vector

##########################################

# simulate

# minimize 1.0e-4 1.0e-6 1000 10000

timestep ${tstep}
#reset_timestep 0
neigh_modify every 1 delay 2 check yes

run ${Nsteps}
