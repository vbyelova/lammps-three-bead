# simulation of singular three-bead model


##########################################
# user input
variable Nsteps         equal 100000
variable Nwrite         equal   1000
variable seed           equal 349503
variable tstep          equal  0.001

##########################################
# configuration
units lj
boundary p p p
atom_style bond         # bead-spring polymer
read_data network.in extra/bond/per/atom 2 extra/special/per/atom 2

labelmap atom 1 stic 2 hinge

group stickers          type 1
group hinges            type 2

molecule mol1 bonded_three_bead.data
molecule mol2 unbonded_three_bead.data

##########################################
# pair interactions
# shifted lj to be repulsive wca

pair_style lj/cut 2.5
#pair_modify shift yes

pair_coeff 1 1 1.5 1.0# 1.1225
pair_coeff 1 2 1.5 1.0# 1.1225
pair_coeff 2 2 1.5 1.0# 1.1225

##########################################
# bond potentials

bond_style harmonic
bond_coeff 1 3 2
bond_coeff 2 3 2

##########################################
# add brownian dynamics

fix 1 all nve                             # NVE integrator
fix 2 all langevin   0.5 0.5 2.0 ${seed}  # langevin thermostat

##########################################

# EXPORT

#### Set up a compute for msd
variable t equal step*${tstep}
#### 1. MSD
compute mymsdcompute all msd
#### and write it to a file
variable themsd equal c_mymsdcompute[4]

variable        s equal logfreq(10,8,10)
#fix mymsdfile all print v_s "${t} ${themsd}" file output/msd.dat screen no

#### 2. THERMODYNAMICS INFO
thermo ${Nwrite}   # print thermodynamic info every Nwrite steps

dump 1 all atom ${Nwrite} output/dump.lammpstrj

##########################################
# minimize

minimize 1.0e-4 1.0e-6 10000 100000

##########################################
# network percolation

#fix ntwrk0 all bond/create 100 1 1 0.8 2
#fix ntwrk1 all bond/create 100 2 2 0.8 2

##########################################

# bond react

fix rxn all bond/react stabilization no &
  react rxn1 stickers 1 2.0 3.0 mol1 mol2 map_three_bead   prob 0.05 ${seed} &
  react rxn2 stickers 1 2.0 3.0 mol2 mol1 map_three_bead   prob 0 ${seed}

compute nbonds all count/type bond
variable tempbonds equal c_nbonds[2]


#compute coords all property/atom xu yu zu
group firstatom id 1
group lastatom id 3

compute cfirst firstatom com
compute clast lastatom com
variable dx equal c_clast[1]-c_cfirst[1]
variable dy equal c_clast[2]-c_cfirst[2]
variable dz equal c_clast[3]-c_cfirst[3]

variable separation equal sqrt(v_dx*v_dx+v_dy*v_dy+v_dz*v_dz)

fix myTADAfile all print v_s "${t} ${tempbonds} ${separation} " file output/nbonds.dat screen no

##########################################
# simulate

# minimize 1.0e-4 1.0e-6 1000 10000

timestep ${tstep}
#reset_timestep 0
neigh_modify every 10 delay 20 check yes

run ${Nsteps}
