unfix nvelim
unfix thermoequil

fix 1 all nve
fix 2 all langevin 1 1 1.0 ${seed}
fix 2 all langevin 1 1 1.0 349503

##########################################

# pair interactions
# shifted lj to be repulsive wca

pair_style hybrid/overlay zero 5 lj/cut ${r_cutoff}
pair_style hybrid/overlay zero 5 lj/cut 1.112462048

pair_coeff * * lj/cut 1.0 1.0
pair_coeff * * zero 5
pair_modify shift yes

###########################################

# angle stuff

include angleInfo.in
# angle coefficents as calculated
angle_style lepton no_offset
angle_coeff 1 2.1508254011447865 'k2*(theta - 2.1508254011447865)^2 + k3*(theta - 2.1508254011447865)^3 + k4*(theta - 2.1508254011447865)^4; k2=-3.164009445987086; k3=0.21772279473466166; k4=1.446813353201654'
compute angles all angle/local theta
compute angle_pe all angle/local eng

fix percolate all bond/create 1 1 1 ${r_cutoff} 2 molecule inter iparam 2 1 jparam 2 1
fix percolate all bond/create 1 1 1 1.112462048 2 molecule inter iparam 2 1 jparam 2 1
##########################################

# simulate

undump 1
reset_timestep 0

dump 1 all custom ${Nwrite} ../output/dump.lammpstrj id x y z type mol
dump 1 all custom 100 ../output/dump.lammpstrj id x y z type mol
dump_modify 1 sort id

variable allbonds equal v_totalintra+v_totalinter

fix nbondsfile all print 100 "${allbonds} " file ../output/nbonds.dat screen no
dump bondedatoms all local ${Nwrite} ../output/bondedatoms.dat index c_bondedatomid1 c_bondedatomid2
dump bondedatoms all local 100 ../output/bondedatoms.dat index c_bondedatomid1 c_bondedatomid2
dump angles all local ${Nwrite} ../output/moleculeangles.dat index c_angles c_angle_pe
dump angles all local 100 ../output/moleculeangles.dat index c_angles c_angle_pe
timestep ${tstep}
timestep 0.001
neighbor 1 bin
neigh_modify every 1 delay 2 check yes

run ${Nsteps}
run 100000
