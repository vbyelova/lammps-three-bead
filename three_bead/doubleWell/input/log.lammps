unfix equilibrate

##########################################



# pair interactions
# shifted lj to be repulsive wca

pair_style hybrid/overlay zero 5.5 lj/cut ${r_cutoff}
pair_style hybrid/overlay zero 5.5 lj/cut 1.112462048

pair_coeff * * lj/cut 1.0 1.0
pair_coeff * * zero 5.5
pair_modify shift yes


# angle stuff

angle_style quartic
angle_coeff 1 120 -0.00284 1.092E-5 4.062E-7

compute angles all angle/local theta

fix percolate all bond/create 1 1 1 1.13 2 molecule inter iparam 2 1 jparam 2 1
##########################################

# simulate. first minimize energy with nve + langevin. then run for longer

#minimize 1.0e-4 1.0e-6 10000 100000

undump 1
reset_timestep 0

dump 1 all custom ${Nwrite} ../output/dump.lammpstrj id x y z type mol
dump 1 all custom 100 ../output/dump.lammpstrj id x y z type mol
dump_modify 1 sort id

fix nbondsfile all print 100 "${t} ${totalintra} ${totalinter} " file ../output/nbonds.dat screen no
dump bondedatoms all local ${Nwrite} ../output/bondedatoms.dat index c_bondedatomid1 c_bondedatomid2 c_btype
dump bondedatoms all local 100 ../output/bondedatoms.dat index c_bondedatomid1 c_bondedatomid2 c_btype
dump angles all local ${Nwrite} ../output/moleculeangles.dat index c_angles
dump angles all local 100 ../output/moleculeangles.dat index c_angles
timestep ${tstep}
timestep 0.001
neighbor 1 bin
neigh_modify every 1 delay 2 check yes

run ${Nsteps}
run 100000
