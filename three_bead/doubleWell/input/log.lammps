LAMMPS (22 Jul 2025)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
# simulation of three bead model with network percolation and
# conformational change.

# here percolation occurs via fix bond/create and unfolding occurs via an angle potential

##########################################

# user input
variable Nsteps         equal 100000
variable Nwrite         equal   100
variable equilTime      equal  3000
variable seed           equal 349503
variable tstep          equal  0.001
variable boxLength      equal     lx
variable com_cutoff         equal 0.43*lx
variable r_cutoff       equal 1.112462048
##########################################

# configuration
units lj
boundary p p p
atom_style angle         # bead-spring polymer with bond and angle data

read_data network.in extra/bond/per/atom 2 extra/special/per/atom 200
Reading data file ...
  orthogonal box = (-10 -10 -10) to (10 10 10)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  30 atoms
  scanning bonds ...
  3 = max bonds/atom
  scanning angles ...
  1 = max angles/atom
  orthogonal box = (-10 -10 -10) to (10 10 10)
  1 by 1 by 1 MPI processor grid
  reading bonds ...
  20 bonds
  reading angles ...
  10 angles
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     1 = max # of 1-3 neighbors
     1 = max # of 1-4 neighbors
   202 = max # of special neighbors
  special bonds CPU = 0.000 seconds
  read_data CPU = 0.001 seconds

min_style fire
##########################################

#print some system info for analysis

variable Npar equal count(all)

print """
boxLength = ${boxLength}
Npar = ${Npar}
Nsteps = ${Nsteps} + ${equilTime}
Nwrite = ${Nwrite}
equilTime = ${equilTime}
""" file ../analysis/systemData.py

boxLength = 20
Npar = 30
Nsteps = 100000 + 3000
Nwrite = 100
equilTime = 3000


##########################################
# bond potentials

bond_style harmonic
bond_coeff 1 5 ${r_cutoff}   #intramolecular
bond_coeff 1 5 1.112462048   
bond_coeff 2 5 ${r_cutoff}   #intermolecular
bond_coeff 2 5 1.112462048   

##########################################

# count bonds per atom

compute intra all nbond/atom bond/type 1
compute inter all nbond/atom bond/type 2

# keep track of bonds across the system

compute totalbonds all count/type bond
variable totalintra equal c_totalbonds[1]
variable totalinter equal c_totalbonds[2]

#########################################

# find bond id and forces

compute bondedatomid1 all property/local batom1
compute bondedatomid2 all property/local batom2
compute btype all property/local btype

compute bondforce all bond/local fx fy fz

##########################################
# print thermodynamic info

variable t equal step*${tstep}
variable t equal step*0.001

thermo ${Nwrite}
thermo 100

##########################################

# add brownian dynamics

fix 1 all nve                             # NVE integrator
fix 2 all langevin   1 1 1.0 ${seed}  # langevin thermostat
fix 2 all langevin   1 1 1.0 349503  

##########################################

# equilibration. first energy minimization and then equilibration

comm_modify cutoff 10

pair_style soft ${r_cutoff}
pair_style soft 1.112462048
pair_coeff * * 5

minimize 1.0e-4 1.0e-6 1000 10000
