LAMMPS (22 Jul 2025)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
# simulation of three bead model with network percolation and
# conformational change.

# here percolation occurs via fix bond/create and unfolding occurs via an angle potential

##########################################

variable conditions string langevin_10_unfold2_refold1.5_Vf0.07_mol3938
variable filename file ${conditions}.txt
variable filename file langevin_10_unfold2_refold1.5_Vf0.07_mol3938.txt

# user input
variable Nsteps         equal 500000
variable Nwrite         equal   1000
variable equilTime      equal  0.2 * ${Nsteps}
variable equilTime      equal  0.2 * 500000
variable seed           equal 324223
variable tstep          equal  0.001
variable boxLength      equal     lx
variable commlength     equal 0.5 * lx
variable r_cutoff       equal 1.112462048
variable prob           equal 1
##########################################

# configuration
units lj
boundary p p p
atom_style angle         # bead-spring polymer with bond and angle data

read_data ../runs/${conditions}/${filename}/input/${filename}.in extra/bond/per/atom 2 extra/special/per/atom 200
read_data ../runs/langevin_10_unfold2_refold1.5_Vf0.07_mol3938/${filename}/input/${filename}.in extra/bond/per/atom 2 extra/special/per/atom 200
read_data ../runs/langevin_10_unfold2_refold1.5_Vf0.07_mol3938/Run1_langevin_10_unfold2_refold1.5_Vf0.07_mol3938/input/${filename}.in extra/bond/per/atom 2 extra/special/per/atom 200
read_data ../runs/langevin_10_unfold2_refold1.5_Vf0.07_mol3938/Run1_langevin_10_unfold2_refold1.5_Vf0.07_mol3938/input/Run1_langevin_10_unfold2_refold1.5_Vf0.07_mol3938.in extra/bond/per/atom 2 extra/special/per/atom 200
