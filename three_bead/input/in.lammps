# simulation of three bead model with network percolation and
# conformational change.


##########################################

# user input
variable Nsteps         equal 200000
variable Nwrite         equal   100
variable equilTime      equal  3000
variable seed           equal 349503
variable tstep          equal  0.001
variable boxLength      equal     lx
variable com_cutoff         equal 0.43*lx
variable r_cutoff       equal 1.112462048
##########################################

# configuration
units lj
boundary p p p
atom_style bond         # bead-spring polymer

read_data network.in extra/bond/per/atom 2 extra/special/per/atom 3


labelmap atom 1 stic 2 hinge

group stickers         type 1
group hinges           type 2

# three bead unfolding template loading
molecule folded intramoltemplate/folded_three_bead.data
molecule unfolded intramoltemplate/unfolded_three_bead.data

# intermolecular template loading

# loading sticker-sticker intermolecular templates
molecule pre_isisfu intermoltemplate/pre_instic_instic_fu_inter.data
molecule post_isisfu intermoltemplate/post_instic_instic_fu_inter.data
molecule pre_isisff intermoltemplate/post_instic_instic_ff_inter.data
molecule post_isisff intermoltemplate/post_instic_instic_ff_inter.data
molecule pre_isisuu intermoltemplate/pre_instic_instic_uu_inter.data
molecule post_isisuu intermoltemplate/post_instic_instic_uu_inter.data

molecule pre_ososfu intermoltemplate/pre_outstic_outstic_fu_inter.data
molecule post_ososfu intermoltemplate/post_outstic_outstic_fu_inter.data
molecule pre_ososff intermoltemplate/pre_outstic_outstic_ff_inter.data
molecule post_ososff intermoltemplate/post_outstic_outstic_ff_inter.data
molecule pre_ososuu intermoltemplate/pre_outstic_outstic_uu_inter.data
molecule post_ososuu intermoltemplate/post_outstic_outstic_uu_inter.data

molecule pre_isosfu intermoltemplate/pre_instic_outstic_fu_inter.data
molecule post_isosfu intermoltemplate/post_instic_outstic_fu_inter.data
molecule pre_isosff intermoltemplate/pre_instic_outstic_ff_inter.data
molecule post_isosff intermoltemplate/post_instic_outstic_ff_inter.data
molecule pre_isosuu intermoltemplate/pre_instic_outstic_uu_inter.data
molecule post_isosuu intermoltemplate/post_instic_outstic_uu_inter.data

molecule pre_osisfu intermoltemplate/pre_outstic_instic_fu_inter.data
molecule post_osisfu intermoltemplate/post_outstic_instic_fu_inter.data
molecule pre_osisff intermoltemplate/pre_outstic_instic_ff_inter.data
molecule post_osisff intermoltemplate/post_outstic_instic_ff_inter.data
molecule pre_osisuu intermoltemplate/pre_outstic_instic_uu_inter.data
molecule post_osisuu intermoltemplate/post_outstic_instic_uu_inter.data


# loading hinge-hinge intermolecular templates
molecule pre_hhfu intermoltemplate/pre_hingehinge_fu_inter.data
molecule post_hhfu intermoltemplate/post_hingehinge_fu_inter.data
molecule pre_hhff intermoltemplate/pre_hingehinge_ff_inter.data
molecule post_hhff intermoltemplate/post_hingehinge_ff_inter.data
molecule pre_hhuu intermoltemplate/pre_hingehinge_uu_inter.data
molecule post_hhuu intermoltemplate/post_hingehinge_uu_inter.data

# loading sticker-hinge intermolecular templates. one is for outer sticker, one is for inner sticker
molecule pre_ishfu intermoltemplate/pre_instic_hinge_fu_inter.data
molecule post_ishfu intermoltemplate/post_instic_hinge_fu_inter.data
molecule pre_ishff intermoltemplate/pre_instic_hinge_ff_inter.data
molecule post_ishff intermoltemplate/post_instic_hinge_ff_inter.data
molecule pre_ishuu intermoltemplate/pre_instic_hinge_uu_inter.data
molecule post_ishuu intermoltemplate/pre_instic_hinge_uu_inter.data

molecule pre_oshfu intermoltemplate/pre_outstic_hinge_fu_inter.data
molecule post_oshfu intermoltemplate/post_outstic_hinge_fu_inter.data
molecule pre_oshff intermoltemplate/pre_outstic_hinge_ff_inter.data
molecule post_oshff intermoltemplate/post_outstic_hinge_ff_inter.data
molecule pre_oshuu intermoltemplate/pre_outstic_hinge_uu_inter.data
molecule post_oshuu intermoltemplate/pre_outstic_hinge_uu_inter.data

##########################################

#print some system info for analysis

variable Npar equal count(all)

print """
boxLength = ${boxLength}
Npar = ${Npar}
Nsteps = ${Nsteps} + ${equilTime}
Nwrite = ${Nwrite}
equilTime = ${equilTime}
""" file ../analysis/systemData.py

##########################################
# bond potentials

bond_style harmonic
bond_coeff 1 5 ${r_cutoff}        # sticker-hinge   (intra)
bond_coeff 2 5 ${r_cutoff}        # sticker-sticker (intra)
bond_coeff 3 5 ${r_cutoff}        # sticker-sticker (inter)
bond_coeff 4 5 ${r_cutoff}        # sticker-hinge   (inter)
bond_coeff 5 5 ${r_cutoff}        # hinge-hinge     (inter)


##########################################

# count bonds per atom

compute shintra all nbond/atom bond/type 1
compute ssintra all nbond/atom bond/type 2
compute ssinter all nbond/atom bond/type 3
compute shinter all nbond/atom bond/type 4
compute hhinter all nbond/atom bond/type 5


# keep track of bonds across the system

compute totalbonds all count/type bond
variable shintra equal c_totalbonds[1]
variable ssintra equal c_totalbonds[2]
variable ssinter equal c_totalbonds[3]
variable shinter equal c_totalbonds[4]
variable hhinter equal c_totalbonds[5]

#########################################

# find bond id and forces

compute bondedatomid1 all property/local batom1
compute bondedatomid2 all property/local batom2

compute bondforce all bond/local fx fy fz


##########################################

# print thermodynamic info

variable t equal step*${tstep}

thermo ${Nwrite}

##########################################

# add brownian dynamics

fix 1 all nve                             # NVE integrator
fix 2 all langevin   1 1 1.0 ${seed}  # langevin thermostat

##########################################

# equilibration. first energy minimization and then equilibration

comm_modify cutoff 10

pair_style soft ${r_cutoff}
pair_coeff * * 5


minimize 1.0e-4 1.0e-6 1000 10000
fix equilibrate all nve/limit 1

dump 1 all custom ${Nwrite} ../output/dump.lammpstrj id x y z type mol c_ssintra c_ssinter c_shinter c_hhinter
dump_modify 1 sort id

timestep 0.0001
run ${equilTime}

unfix equilibrate

##########################################



# pair interactions
# shifted lj to be repulsive wca

pair_style hybrid/overlay zero 5.5 lj/cut 2.5

pair_coeff * * lj/cut 1.0 1.0
pair_coeff * * zero 5.5
pair_modify shift yes


##########################################

# variables for bell equation

compute bondhinge hinges bond/local engpot
compute bondstic stickers bond/local engpot

variable ebarrier equal 5 # energy barrier

##########################################

# bond react

# the only intramolecular reaction is the unfolding process
# the intermolecular reactions are all bond formations between each atom type
fix rxn all bond/react stabilization no reset_mol_ids no &
  react unfolding all 1 1.0 5.0 folded unfolded intramoltemplate/three_bead.map molecule intra &
  react isisfu all 1 1.0 1.4 pre_isisfu post_isisfu intermoltemplate/sticstic_inter.map molecule inter &
  react isisff all 1 1.0 1.4 pre_isisff post_isisff intermoltemplate/sticstic_inter.map molecule inter &
  react isisuu all 1 1.0 1.4 pre_isisuu post_isisuu intermoltemplate/sticstic_inter.map molecule inter &
  react ososfu all 1 1.0 1.4 pre_ososfu post_ososfu intermoltemplate/sticstic_inter.map molecule inter &
  react ososff all 1 1.0 1.4 pre_ososff post_ososff intermoltemplate/sticstic_inter.map molecule inter &
  react ososuu all 1 1.0 1.4 pre_ososuu post_ososuu intermoltemplate/sticstic_inter.map molecule inter &
  react isosfu all 1 1.0 1.4 pre_isosfu post_isosfu intermoltemplate/sticstic_inter.map molecule inter &
  react isosff all 1 1.0 1.4 pre_isosff post_isosff intermoltemplate/sticstic_inter.map molecule inter &
  react isosuu all 1 1.0 1.4 pre_isosuu post_isosuu intermoltemplate/sticstic_inter.map molecule inter &
  react osisfu all 1 1.0 1.4 pre_ososfu post_osisfu intermoltemplate/sticstic_inter.map molecule inter &
  react osisff all 1 1.0 1.4 pre_ososff post_osisff intermoltemplate/sticstic_inter.map molecule inter &
  react osisuu all 1 1.0 1.4 pre_ososuu post_osisuu intermoltemplate/sticstic_inter.map molecule inter &
  react hhfu all 1 1.0 1.4 pre_hhfu post_hhfu intermoltemplate/hingehinge_inter.map molecule inter &
  react hhff all 1 1.0 1.4 pre_hhff post_hhff intermoltemplate/hingehinge_inter.map molecule inter &
  react hhuu all 1 1.0 1.4 pre_hhuu post_hhuu intermoltemplate/hingehinge_inter.map molecule inter &
  react ishfu all 1 1.0 1.4 pre_ishfu post_ishfu intermoltemplate/instic_hinge_inter.map molecule inter &
  react ishff all 1 1.0 1.4 pre_ishff post_ishff intermoltemplate/instic_hinge_inter.map molecule inter &
  react ishuu all 1 1.0 1.4 pre_ishuu post_ishuu intermoltemplate/instic_hinge_inter.map molecule inter &
  react oshfu all 1 1.0 1.4 pre_oshfu post_oshfu intermoltemplate/outstic_hinge_inter.map molecule inter &
  react oshff all 1 1.0 1.4 pre_oshff post_oshff intermoltemplate/outstic_hinge_inter.map molecule inter &
  react oshuu all 1 1.0 1.4 pre_oshuu post_oshuu intermoltemplate/outstic_hinge_inter.map molecule inter 



########################################

# simulate. first minimize energy with nve + langevin. then run for longer

minimize 1.0e-4 1.0e-6 10000 100000

undump 1 
reset_timestep 0

dump 1 all custom ${Nwrite} ../output/dump.lammpstrj id x y z type mol c_ssintra c_ssinter c_shinter c_hhinter
dump_modify 1 sort id

fix nbondsfile all print 1000 "${t} ${ssintra} ${ssinter} ${shinter} ${hhinter}" file ../output/nbonds.dat screen no
dump bondedatoms all local ${Nwrite} ../output/bondedatoms.dat index c_bondedatomid1 c_bondedatomid2 c_bondforce[*]

timestep ${tstep}
neighbor 1 bin
neigh_modify every 1 delay 2 check yes

run ${Nsteps}
